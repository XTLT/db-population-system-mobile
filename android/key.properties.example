# APK签名配置
# 
# 生产环境必须配置正式签名，否则APK可被篡改
# 
# 使用方法：
# 1. 复制此文件为 key.properties
# 2. 修改以下配置为实际值
# 3. 确保 key.properties 文件不要提交到版本控制（已在 .gitignore 中）

storeFile=/path/to/your/keystore.jks
storePassword=your_store_password
keyAlias=your_key_alias
keyPassword=your_key_password

# 创建签名密钥：
# keytool -genkey -v -keystore release.keystore -alias population_query -keyalg RSA -keysize 2048 -validity 10000
# 
# 查看签名指纹：
# keytool -list -v -keystore release.keystore -alias population_query
# 
# 签名APK：
# flutter build apk --release
# 
# 验证签名：
# apksigner verify --print-certs build/app/outputs/flutter-apk/app-release.apk
